AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b

# ---- Lead capture (contact form) ----
# Channel 1: Email (Brevo / Sendinblue) — https://app.brevo.com se API key lo
BREVO_API_KEY=
# jis email par enquiry aani chahiye (multiple allowed, comma separated)
ENQUIRY_TO_EMAIL=
# Brevo me verified sender email (default = ENQUIRY_TO_EMAIL)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Maa Mansa Devi Glass Works"

# Channel 1b: Email (Resend) — alternative, agar Brevo use na karna ho
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="Maa Mansa Devi Glass Works <onboarding@resend.dev>"

# Channel 2: Google Sheet (Apps Script web app URL)
# Sheet banakar Apps Script -> "doPost" web app deploy karo, URL yahan paste karo
SHEET_WEBHOOK_URL=

# Local dev me lead JSON file me save karne ke liye (production par kaam nahi karta)
# CONTACT_PHONE=
